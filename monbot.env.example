# monbot .env - COPY this file to `.env` on the VPS and fill the values.
# NEVER paste a token or key in chat. Keys sirf VPS par .env me.
# File: /opt/monbot/.env
#
# NOTE: monbot needs NO Telegram bot token and NO userbot session. It never
# posts to Telegram - the main bot owns all posting. Do NOT add any token
# or session vars here. (Sharing a userbot session between two bots
# disconnects one of them - that is what hit dropbot on Nov 24.)

# --- Data dir (monbot ka apna record yahan) ---
MONBOT_DATA_DIR=/opt/monbot/data

# --- Main bot data dir (READ-ONLY source) ---
MONBOT_MAIN_DATA_DIR=/opt/bot/data

# --- Tick intervals (main bot ke .env jaisi values) ---
MONBOT_TICK_SECONDS=2
MONBOT_PRIO_SECONDS=1

# --- MC fetch keys (main bot ki /opt/bot/.env wali keys hi use karo) ---
# Birdeye key _fetch_alt_sources_sync use karta hai.
BIRDEYE_API_KEY=<redacted>
MORALIS_API_KEY=<redacted>
CMC_API_KEY=<redacted>
EXTRA_SOURCES_ENABLED=1

# --- Monitoring env (main bot ke naam, same defaults) ---
MONITOR_MAX_CHECKS_PER_TICK=110
MONITOR_PRIORITY_MAX_CHECKS_PER_TICK=130
MONITOR_MAX_FALLBACKS_PER_TICK=10
MONITOR_PRIORITY_MAX_FALLBACKS_PER_TICK=16
MONITOR_BULK_MAX_BATCHES=3
HOT_WINDOW_SECONDS=180
WARM_EVERY_N_TICKS=2
REGULAR_MIN_SHARE=0.4
SOFT_GATE_RECORD_ONLY=0
